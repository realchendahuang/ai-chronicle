{
  "name": "ai-chronicle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm build && python3 -m http.server 43117 --directory dist/client",
    "dev:fast": "pnpm build:content && pnpm build:site && python3 -m http.server 43117 --directory dist/client",
    "clean": "node scripts/clean.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build:content": "velite",
    "build:site": "node scripts/ssg.mjs",
    "build": "pnpm build:content && pnpm build:site && node scripts/check-editorial.mjs && node scripts/check-site.mjs",
    "build:full": "pnpm optimize:images && pnpm build",
    "check": "pnpm build",
    "check:editorial": "node scripts/check-editorial.mjs",
    "check:site": "node scripts/check-site.mjs",
    "serve": "python3 -m http.server 43117 --directory dist/client",
    "deploy": "pnpm build:full && pnpm exec wrangler pages deploy dist/client --branch=main",
    "deploy:worker": "pnpm exec wrangler deploy -c worker/wrangler.toml",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "velite": "^0.2.4",
    "wrangler": "4.125.0"
  }
}
